# Defaults to local API on this PC; when a LAN device opens the frontend via PC IPv4,
# Nexora automatically replaces localhost with that LAN IP.
VITE_API_URL=http://localhost:4001/api
VITE_HOST=0.0.0.0
VITE_PORT=5173

# For temporary ngrok testing, set these in client/.env.local (not here):
# NGROK_HOST=your-frontend-host.ngrok-free.app
# VITE_API_URL=https://your-api-host.ngrok-free.app/api
